# AI provider selection (optional). When unset, the provider is inferred
# from whichever API key is present. When set, the matching key is required.
# AI_PROVIDER=anthropic
# AI_PROVIDER=deepseek

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_BASE_URL=https://api.anthropic.com

# DeepSeek
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1/chat/completions

# Brave Search (optional; only needed when web search uses provider=brave)
# BRAVE_API_KEY=
